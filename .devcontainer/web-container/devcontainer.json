{
  "name": "Web",
  "dockerComposeFile": [
    "../../docker-compose.yml"
  ],
  "service": "web",
  "runServices": [
    "web"
  ],
  "shutdownAction": "none",
  "workspaceFolder": "/workspace/web",
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      "settings": {
        "js/ts.experimental.useTsgo": true,
        "js/ts.tsdk.path": "./node_modules/typescript",
        "files.associations": {
          "*.css": "tailwindcss"
        },
        "editor.quickSuggestions": {
          "strings": "on"
        }
      },
      "extensions": [
        "TypeScriptTeam.native-preview",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
