{
  "name": "API",
  "dockerComposeFile": [
    "../../docker-compose.yml"
  ],
  "service": "api",
  "runServices": [
    "api"
  ],
  "shutdownAction": "none",
  "workspaceFolder": "/workspace/api",
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      "settings": {
        "remote.restoreForwardedPorts": false,
        "gopls": {
          "formatting.gofumpt": true,
          "ui.diagnostic.staticcheck": true
        }
      },
      "extensions": [
        "golang.Go"
      ]
    }
  }
}
