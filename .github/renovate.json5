// Renovate のリポジトリ設定。実行設定（対象・認証・ログレベル）は .github/workflows/renovate.yml の環境変数で渡す。
// 理由をコメントで残すため JSON5 にしており、jq の代わりに renovate-config-validator で検査する（ci.yml）。
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // dockerfileVersions は Dockerfile の # renovate: 付き <名前>_VERSION を追う。標準の dockerfile manager は
  // ARG を依存にしない（44.95.0 の --dry-run=extract で実測）。
  // https://docs.renovatebot.com/presets-customManagers/#custommanagersdockerfileversions
  extends: ['config:best-practices', 'customManagers:dockerfileVersions'],

  // :maintainLockFilesWeekly など、プリセット内のスケジュールを評価する基準時刻
  timezone: 'Asia/Tokyo',

  // ラベルは scripts/apply-repo-settings.sh が管理しているものを使う
  labels: ['dependencies'],
  dependencyDashboardLabels: ['dependencies'],

  // 件名を日本語の語順にするため、非推奨の commitMessage 上書きではなく部品を差し替える。版・digest 更新の文言は packageRules 側。
  // https://docs.renovatebot.com/configuration-options/#commitmessage
  semanticCommits: 'enabled',
  commitMessageAction: '',
  commitMessageTopic: '{{depName}} を',
  // 既定（auto）だと semanticCommitType が小文字のとき件名全体を小文字化し、depName の大文字（owner 名など）が潰れる
  commitMessageLowerCase: 'never',

  // 種別ごとの既定文言は上の部品より後に合成されて英語に戻るため、種別側でも日本語にする。group の文言は
  // commitMessageExtra に置くと消される（generate.ts。dry-run で実測）ので commitMessageTopic に置く。
  pin: {
    commitMessageAction: '',
    commitMessageExtra: '{{newValue}} に固定',
    group: { commitMessageTopic: '依存関係のバージョンを固定', commitMessageExtra: '' },
  },
  pinDigest: {
    commitMessageAction: '',
    commitMessageExtra: '{{newDigestShort}} に固定',
    group: { commitMessageTopic: '依存関係の digest を固定', commitMessageExtra: '' },
  },
  rollback: {
    commitMessageAction: '',
    commitMessageExtra: '{{newValue}} に戻す',
  },
  replacement: {
    commitMessageAction: '',
    commitMessageExtra: '{{newName}} {{newValue}} に置き換え',
  },

  packageRules: [
    // major 以外は CI が通れば自動マージする（pinDigest は実行されるイメージを変えないため含める）。
    // GitHub の auto-merge と必須チェックが前提（apply-repo-settings.sh / rulesets/main.json）。
    {
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
      automerge: true,
    },
    // web は公開しないアプリなので、devDependencies（:pinDevDependencies）と同じく dependencies も固定する。
    // 対象を npm に絞るため、全 manager に効く :pinAllExceptPeerDependencies は使わない。
    // https://docs.renovatebot.com/dependency-pinning/
    {
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies'],
      rangeStrategy: 'pin',
    },
    // github-actions manager は uses-with の入力に digest を書けず、pin のブランチ全体が失敗するため無効にする
    // （dry-run で実測。書けないことの上流の根拠は未検証）。https://docs.renovatebot.com/modules/manager/github-actions/
    {
      matchManagers: ['github-actions'],
      matchDepTypes: ['uses-with'],
      pinDigests: false,
    },
    // shellcheck はリリース間隔が閾値（1年）より長いが開発は続いており、判断材料にならない指摘が常駐するため対象から外す。
    // 照合するのは packageName で、aqua バックエンドの名前を除いた形になる（dry-run で実測）。
    // https://docs.renovatebot.com/presets-abandonments/
    {
      matchPackageNames: ['koalaman/shellcheck'],
      abandonmentThreshold: null,
    },
    // manager・datasource の既定文言はトップレベルより後に合成されて勝つため、最後に適用される packageRules で決める（#26）。
    // v は自前で付けず prettyNewVersion に任せる。v 始まりのタグに v が重なるのを防ぐため（#35）。
    {
      matchUpdateTypes: ['major', 'minor', 'patch'],
      commitMessageTopic: '{{depName}} を',
      // editorconfig-checker-disable-next-line
      commitMessageExtra: '{{#if isMajor}}{{{prettyNewMajor}}}{{else}}{{#if isSingleVersion}}{{{prettyNewVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}} に更新',
    },
    {
      matchUpdateTypes: ['digest'],
      commitMessageTopic: '{{depName}} の digest を',
      commitMessageExtra: '{{newDigestShort}} に更新',
    },
  ],
}
