root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = unset

# make requires tab-indented recipes, and gofmt enforces tabs; both mix in
# space-aligned continuation lines, so the indent checks are off entirely.
[{Makefile,*.go}]
indent_style = unset
indent_size = unset
