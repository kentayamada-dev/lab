root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# editorconfig-checker は utf-8 なら文字数で数える。値は yamllint の line-length（.github/ci.yamllint.yml）と揃える。
# 折り返せない行（URL・digest）は editorconfig-checker-disable-next-line で個別に外す。
max_line_length = 120

# 番号付きリストの継続行はマーカー幅（"1. " = 3桁）に揃えるため、2の倍数にならない
[*.md]
indent_size = unset

# Make のレシピ行はタブ必須。この節が無いと editorconfig-checker がタブを指摘する（4.0.1 で実測）。
# https://www.gnu.org/software/make/manual/make.html
[Makefile]
indent_style = tab

# gofmt と go コマンド（go.mod の require）はタブで字下げし、設定で変えられないため。https://pkg.go.dev/cmd/gofmt
[{*.go,go.mod}]
indent_style = tab

# shfmt の整形設定。整形フラグを1つでも渡すと .editorconfig を読まなくなる（v3.14.1 で実測）ので、フラグではなくここに書く。
# switch_case_indent は既存スクリプトの書き方に合わせ、space_redirects は既存が混在しているため既定のままにする。
# https://github.com/mvdan/sh/blob/master/cmd/shfmt/shfmt.1.scd
[*.{sh,bash,bats}]
switch_case_indent = true
